{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "PYTHONPATH=src python3 -m autotrader.web.build --out public --live data/live",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/markets-pro/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/stocks.json",
      "destination": "/markets-pro/stocks.json"
    },
    {
      "source": "/funds.json",
      "destination": "/markets-pro/funds.json"
    },
    {
      "source": "/screener-cards.html",
      "destination": "/markets-pro/screener-cards.html"
    },
    {
      "source": "/watchlist-rows.html",
      "destination": "/markets-pro/watchlist-rows.html"
    },
    {
      "source": "/",
      "destination": "/markets-pro/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; connect-src 'self' https://wvnqyegqxgvjbgqujyom.supabase.co; base-uri 'none'; form-action https://kite.zerodha.com; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/broker/*.py": {
      "includeFiles": "src/**"
    }
  }
}
