# Supabase — used only by autotrader.persistence.store.SupabaseWriter.
# Use the SERVICE ROLE key: the mkt_* tables have RLS enabled with no
# permissive policy, so the anon key cannot read or write them.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# Never commit the real .env — it is gitignored.
